<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="IpcAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:background">#FFFFFF</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="FloatingBottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FloatingBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
    </style>

    <style name="FloatingBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#FFFFFF</item>
        <item name="shapeAppearance">@style/FloatingBottomSheetShape</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="FloatingBottomSheetShape" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

</resources>